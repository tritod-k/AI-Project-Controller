{
  "$defs": {
    "CriterionResult": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Criterion Id",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "notes": {
          "title": "Notes",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CriterionStatus"
        }
      },
      "required": [
        "criterion_id",
        "status",
        "evidence",
        "notes"
      ],
      "title": "CriterionResult",
      "type": "object"
    },
    "CriterionStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "UNVERIFIED"
      ],
      "title": "CriterionStatus",
      "type": "string"
    },
    "JsonValue": {},
    "ProjectStatus": {
      "enum": [
        "NEW",
        "READY",
        "RUNNING",
        "WAITING_APPROVAL",
        "WAITING_HUMAN",
        "PAUSED",
        "COMPLETED",
        "FAILED",
        "CANCELLED",
        "INTERRUPTED",
        "RECOVERING",
        "WAITING_PROVIDER"
      ],
      "title": "ProjectStatus",
      "type": "string"
    },
    "RetryCounters": {
      "additionalProperties": false,
      "properties": {
        "phase_revision": {
          "default": 0,
          "minimum": 0,
          "title": "Phase Revision",
          "type": "integer"
        },
        "provider_retry": {
          "default": 0,
          "minimum": 0,
          "title": "Provider Retry",
          "type": "integer"
        },
        "review_retry": {
          "default": 0,
          "minimum": 0,
          "title": "Review Retry",
          "type": "integer"
        }
      },
      "title": "RetryCounters",
      "type": "object"
    },
    "ReviewResult": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/CriterionResult"
          },
          "title": "Criteria",
          "type": "array"
        },
        "failed_criteria": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Failed Criteria",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "next_phase_allowed": {
          "title": "Next Phase Allowed",
          "type": "boolean"
        },
        "required_fixes": {
          "items": {
            "type": "string"
          },
          "title": "Required Fixes",
          "type": "array"
        },
        "review_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Review Id",
          "type": "string"
        },
        "risks": {
          "items": {
            "type": "string"
          },
          "title": "Risks",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "task_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Task Id",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/ReviewVerdict"
        }
      },
      "required": [
        "schema_version",
        "review_id",
        "task_id",
        "verdict",
        "confidence",
        "criteria",
        "failed_criteria",
        "required_fixes",
        "risks",
        "next_phase_allowed"
      ],
      "title": "ReviewResult",
      "type": "object"
    },
    "ReviewVerdict": {
      "enum": [
        "PASS",
        "REVISE",
        "BLOCKED",
        "ERROR"
      ],
      "title": "ReviewVerdict",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active_task_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Active Task Id"
    },
    "blocked_phases": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Blocked Phases",
      "type": "array"
    },
    "completed_phases": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Completed Phases",
      "type": "array"
    },
    "current_attempt": {
      "exclusiveMinimum": 0,
      "title": "Current Attempt",
      "type": "integer"
    },
    "current_phase": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Current Phase"
    },
    "last_review": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "project_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Project Id",
      "type": "string"
    },
    "retries": {
      "$ref": "#/$defs/RetryCounters"
    },
    "run_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ProjectStatus"
    },
    "updated_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:[Zz]|[+-][0-9]{2}:[0-9]{2})$",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "run_id",
    "current_phase",
    "current_attempt",
    "status",
    "completed_phases",
    "blocked_phases",
    "active_task_id",
    "last_review",
    "updated_at"
  ],
  "title": "ProjectState",
  "type": "object"
}
